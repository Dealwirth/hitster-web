{
  "name": "hitster-web",
  "version": "4.6.0",
  "description": "Kostenlose Hitster-Karten-Erweiterung mit 4.701 Songs, echten Hitster-QR-Codes, Spotify-Playlist-Modus (alle Tracks), eigenen Kategorien, 30-Sekunden-Clips und Druckbogen. Kein Login, keine Werbung, kein Online-Mehrspieler.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:catalog": "node scripts/build-catalog.js",
    "build:charts": "node scripts/add-chart-songs.js",
    "test": "node --test tests/catalog.test.js tests/api.test.js tests/range.test.js tests/hitster-cards.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:a11y": "node tests/a11y.mjs",
    "test:audio": "node tests/sample-audio.mjs && node tests/fallback-audio.mjs",
    "screenshots": "node tests/screenshots.mjs",
    "test:small": "node tests/small-viewport.mjs",
    "build:static": "node scripts/build-static.js",
    "build:hitster": "node scripts/build-hitster-db.js",
    "import:cards": "node scripts/import-songseeker.js",
    "add:rock": "node scripts/add-songseeker-rock.js",
    "add:years": "node scripts/add-year-fillers.js",
    "build:icons": "node scripts/build-icons.js",
    "enrich:popularity": "node scripts/enrich-popularity-slow.js",
    "test:v4": "node tests/v4.test.js",
    "test:static": "node tests/static.test.js",
    "test:v5": "node tests/v5.test.js",
    "test:all": "npm test && npm run test:v4 && npm run test:v5 && npm run test:static"
  },
  "keywords": [
    "hitster",
    "musik",
    "quiz",
    "partyspiel",
    "spotify",
    "open-source"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
