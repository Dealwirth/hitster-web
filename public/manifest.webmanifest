{
  "name": "HITSTER Web – Karten-Erweiterung",
  "short_name": "HITSTER Web",
  "description": "Kostenlose Hitster-Karten-Erweiterung mit 4.421 Songs, echten Hitster-QR-Codes, Playlist-Modus und Karten zum Drucken. Kein Login, keine Werbung.",
  "lang": "de",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0b0d",
  "theme_color": "#0b0b0d",
  "categories": ["music", "games", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Neue Karte", "short_name": "Karte", "url": "./?mode=classic", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Karte scannen", "short_name": "Scannen", "url": "./?mode=extension", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
